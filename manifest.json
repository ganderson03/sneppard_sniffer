{
  "manifest_version": 3,
  "name": "Prompt Injection Sniffer",
  "version": "0.1.0",
  "description": "Detects hidden text and prompt injection patterns on web pages that could hijack AI browser assistants.",
  "permissions": ["activeTab", "storage", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "src/service-worker.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/detector.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Prompt Injection Sniffer"
  }
}
